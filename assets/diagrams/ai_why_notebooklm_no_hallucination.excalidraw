      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🌊 คลังความรู้: มหาสมุทรข้อมูลอินเทอร์เน็ต (Pre-trained)",
      "lineHeight": 1.35,
      "autoResize": true
