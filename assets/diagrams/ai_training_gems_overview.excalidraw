    {
      "id": "z2_c1_desc",
      "type": "text",
      "x": 545,
      "y": 274,
      "width": 420,
      "height": 210,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
