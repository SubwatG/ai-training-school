      "seed": 1721096745,
      "version": 1,
      "versionNonce": 1185387817,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787897000000,
      "link": null,
      "locked": false,
      "text": "• AI ปัจจุบันที่เก่งเฉพาะงานที่ถูกเทรนมา\n• ทำตามกฎและรูปแบบที่กำหนดไว้ตายตัว\n• ตัวอย่าง: แนะนำวิดีโอ YouTube, Face ID,\n  สแกนตัดสแปมเมล, ระบบแปลภาษาตามคำศัพท์",
      "fontSize": 13.5,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• AI ปัจจุบันที่เก่งเฉพาะงานที่ถูกเทรนมา\n• ทำตามกฎและรูปแบบที่กำหนดไว้ตายตัว\n• ตัวอย่าง: แนะนำวิดีโอ YouTube, Face ID,\n  สแกนตัดสแปมเมล, ระบบแปลภาษาตามคำศัพท์",
      "lineHeight": 1.45,
      "autoResize": true
    },
