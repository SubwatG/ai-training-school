    {
      "id": "z1_c1_desc",
      "type": "text",
      "x": 75,
      "y": 274,
      "width": 360,
      "height": 125,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
